---
import "../styles/global.css";
import { codeToTokens } from "shiki";
import QueryStepper from "../components/sql-order/QueryStepper";
import { QUERY_LINES } from "../lib/sql-order/steps";

const { tokens } = await codeToTokens(QUERY_LINES.join("\n"), {
  lang: "sql",
  theme: "github-dark",
});
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The order SQL actually runs your query</title>
  </head>
  <body class="min-h-screen bg-[#010409] text-gray-200">
    <main class="mx-auto max-w-5xl p-8">
      <QueryStepper client:load tokens={tokens} />
    </main>
  </body>
</html>