---
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = [
  {
    href: "/posts/sql-order",
    title: "The order SQL actually runs your query",
    blurb: "You write SELECT first. The database runs it fifth.",
  },
];
---
<BaseLayout title="HAFSA GPT" description="Interactive explanations of how backend and data tech actually works.">
  <main class="mx-auto max-w-3xl px-8 py-16">
    <h1 class="text-3xl font-semibold">HAFSA GPT</h1>
    <p class="mt-2 text-gray-400">The theory you learned, and how it works in practice.</p>

    <ul class="mt-10 space-y-6">
      {posts.map((p) => (
        <li>
          <a href={p.href} class="group block">
            <h2 class="text-lg group-hover:text-yellow-400">{p.title}</h2>
            <p class="text-sm text-gray-500">{p.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>