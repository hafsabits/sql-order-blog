---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  question?: string; // the post's central question, shown under the title
}
const { title, description, question } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-8 py-6">
    <a href="/" class="text-sm text-gray-500 hover:text-gray-300">← all posts</a>
    <h1 class="mt-4 text-2xl font-semibold">{title}</h1>
    {question && <p class="mt-1 text-gray-400">{question}</p>}
    <div class="mt-6">
      <slot />
    </div>
  </main>
</BaseLayout>